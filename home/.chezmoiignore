# GlazeWM, Kanata, the PowerShell profile, and the Windows Terminal fragment
# are Windows-only; don't deploy them on Linux/WSL machines.
{{ if ne .chezmoi.os "windows" }}
.glzr
.config/kanata.kbd
Documents/PowerShell
AppData/Local/Microsoft/Windows Terminal
{{ end }}

# Mirror image: the zsh/tmux shell environment and the Linux release binaries
# are meant for Linux/WSL, so keep them off native Windows (where the GlazeWM +
# PowerShell setup lives instead). git and starship stay put — the PowerShell
# profile uses starship for its prompt.
{{ if eq .chezmoi.os "windows" }}
# Shell + CLI config
.config/zsh
.zshenv
.config/tmux
.tmux-cht-command
.tmux-cht-languages
.config/sheldon
.config/tmux-sessionizer
.config/jrnl
# Linux release binaries and bash helpers under ~/.local
.local/bin
.local/share/tmux
.local/share/quarto
# bash setup scripts. chezmoi files scripts under a synthetic
# ".chezmoiscripts/" namespace, distinct from the regular target tree, so
# ignore patterns for them need that prefix — a bare basename here silently
# never matches, and the script still runs (and fails: no bash on Windows).
.chezmoiscripts/install-node.sh
.chezmoiscripts/install-nvim.sh
.chezmoiscripts/install-python-env.sh
.chezmoiscripts/install-rust.sh
.chezmoiscripts/jrnl.sh
.chezmoiscripts/chsh.sh
.chezmoiscripts/install_packages.sh
.chezmoiscripts/create_symlinks.sh
.chezmoiscripts/install-gh.sh
.chezmoiscripts/install-claude-code.sh
{{ end }}
