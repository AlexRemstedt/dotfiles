#!/bin/sh
# Git credential helper for Overleaf: fetches the git token from 1Password at
# request time so it is never written to disk. Only answers "get"; store/erase
# are no-ops because 1Password is the source of truth.
[ "$1" = get ] || exit 0
cat >/dev/null # drain the request git sends on stdin

ref="${OVERLEAF_TOKEN_REF:-op://development/overleaf/credential}"
op=$(command -v op.exe || command -v op) || exit 0

token=$("$op" read "$ref" | tr -d '\r')
if [ -z "$token" ]; then
  echo "git-credential-overleaf: could not read $ref (is 1Password unlocked?)" >&2
  exit 0
fi

printf 'username=git\npassword=%s\n' "$token"
