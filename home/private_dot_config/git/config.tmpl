
[user]
  name = Remstedt, Alex
{{- if .gitEmail }}
  email = {{ .gitEmail }}
{{- end }}
{{- if .sshPublicKey }}
  signingkey = {{ .sshPublicKey }}

[gpg]
  format = ssh

{{ if .work -}}
[gpg "ssh"]
	program = "/mnt/c/Users/ARem/AppData/Local/Microsoft/WindowsApps/op-ssh-sign-wsl.exe"
{{ else -}}
[gpg "ssh"]
  program = "/mnt/c/Users/A. Remstedt/AppData/Local/Microsoft/WindowsApps/op-ssh-sign-wsl.exe"
{{ end }}
[commit]
  gpgsign = true
{{- end }}


{{ if .op }}
[core]
  sshCommand = "/mnt/c/Windows/System32/OpenSSH/ssh.exe"
{{ end }}

[core]
  pager = delta

[interactive]
  diffFilter = delta --color-only

[delta]
  navigate = true
  line-numbers = true
  side-by-side = true

[merge]
  tool = "nvim"

[mergetool]
  keepBackup = false
  prompt = false

[mergetool "nvim"]
        cmd = nvim -d -c \"wincmd l\" -c \"norm ]c\" \"$LOCAL\" \"$MERGED\" \"$REMOTE\"


[diff]
  tool = vimdiff
  colorMoved = default

[difftool]
  prompt = false

[difftool "vimdiff"]
  cmd = vimdiff "$LOCAL" "$REMOTE"

[alias]
  cwt = "!sh $HOME/.local/bin/clone-bare-for-worktrees.sh"
  dst = difftool

[push]
  default = simple
  autoSetupRemote = true

[init]
  defaultBranch = main
