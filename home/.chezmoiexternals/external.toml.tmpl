{{- if not .ephemeral -}}
{{/* $arch:    x86_64 / aarch64 naming (atuin, uv, bob, rustup, eza, ...) */}}
{{/* $archAlt: x86_64 / arm64 naming   (lazygit, lazydocker)             */}}
{{-   $arch := .chezmoi.arch -}}
{{-   $archAlt := .chezmoi.arch -}}
{{-   if eq .chezmoi.arch "amd64" -}}{{- $arch = "x86_64" -}}{{- $archAlt = "x86_64" -}}{{- end -}}
{{-   if eq .chezmoi.arch "arm64" -}}{{- $arch = "aarch64" -}}{{- $archAlt = "arm64" -}}{{- end }}

[".local/bin/atuin"]
type = "archive-file"
url = {{ gitHubLatestReleaseAssetURL "atuinsh/atuin" (printf "atuin-%s-unknown-linux-gnu.tar.gz" $arch) | quote }}
path = "atuin-{{ $arch }}-unknown-linux-gnu/atuin"
executable = true
refreshPeriod = "720h"

[".local/bin/rustup-init"]
type = "file"
url = "https://static.rust-lang.org/rustup/dist/{{ $arch }}-unknown-linux-gnu/rustup-init"
executable = true
refreshPeriod = "720h"

[".local/bin/fzf"]
type = "archive-file"
url = {{ gitHubLatestReleaseAssetURL "junegunn/fzf" (printf "fzf-*-linux_%s.tar.gz" .chezmoi.arch) | quote }}
executable = true
path = "fzf"
refreshPeriod = "720h"

[".local/bin/eza"]
type = "archive-file"
url = {{ gitHubLatestReleaseAssetURL "eza-community/eza" (printf "eza_%s-unknown-linux-gnu.tar.gz" $arch) | quote }}
executable = true
path = "./eza"
refreshPeriod = "720h"

[".local/bin/sheldon"]
type = "archive-file"
url = {{ gitHubLatestReleaseAssetURL "rossmacarthur/sheldon" (printf "sheldon-*-%s-unknown-linux-musl.tar.gz" $arch) | quote }}
executable = true
path = "sheldon"
refreshPeriod = "720h"

[".local/bin/starship"]
type = "archive-file"
url = {{ gitHubLatestReleaseAssetURL "starship/starship" (printf "starship-%s-unknown-linux-gnu.tar.gz" $arch) | quote }}
executable = true
path = "starship"
refreshPeriod = "720h"

[".local/share/tmux/plugins/tpm"]
type = "git-repo"
url = "https://github.com/tmux-plugins/tpm.git"
refreshPeriod = "168h"

[".local/bin/zoxide"]
url = {{ gitHubLatestReleaseAssetURL "ajeetdsouza/zoxide" (printf "zoxide-*-%s-unknown-linux-musl.tar.gz" $arch) | quote }}
type = "archive-file"
executable = true
path = "zoxide"
refreshPeriod = "720h"

[".local/bin/bob"]
url = {{ gitHubLatestReleaseAssetURL "MordechaiHadad/bob" (printf "bob-linux-%s.zip" $arch) | quote }}
type = "archive-file"
executable = true
path = "bob-linux-{{ $arch }}/bob"
refreshPeriod = "721h"

[".local/bin/lazygit"]
type = "archive-file"
url = {{ gitHubLatestReleaseAssetURL "jesseduffield/lazygit" (printf "lazygit_*_linux_%s.tar.gz" $archAlt) | quote }}
executable = true
path = "lazygit"
refreshPeriod = "720h"

[".local/bin/lazydocker"]
url = {{ gitHubLatestReleaseAssetURL "jesseduffield/lazydocker" (printf "lazydocker_*_Linux_%s.tar.gz" $archAlt) | quote }}
type = "archive-file"
executable = true
path = "lazydocker"
refreshPeriod = "720h"


[".local/bin/uv"]
type = "archive-file"
url = {{ gitHubLatestReleaseAssetURL "astral-sh/uv" (printf "uv-%s-unknown-linux-gnu.tar.gz" $arch) | quote }}
refreshPeriod = "72h"
executable = true
path = "uv-{{ $arch }}-unknown-linux-gnu/uv"

[".local/bin/fnm"]
type = "archive-file"
url = {{ gitHubLatestReleaseAssetURL "Schniz/fnm" "fnm-linux.zip" | quote }}
path = "fnm"
executable = true
refreshPeriod = "72h"

{{- $deltaVer := (gitHubLatestRelease "dandavison/delta").TagName }}
[".local/bin/delta"]
type = "archive-file"
url = {{ gitHubLatestReleaseAssetURL "dandavison/delta" (printf "delta-*-%s-unknown-linux-gnu.tar.gz" $arch) | quote }}
path = "delta-{{ $deltaVer }}-{{ $arch }}-unknown-linux-gnu/delta"
executable = true
refreshPeriod = "720h"

[".local/bin/diffsitter"]
type = "archive-file"
url = {{ gitHubLatestReleaseAssetURL "afnanenayet/diffsitter" (printf "diffsitter-%s-unknown-linux-gnu.tar.gz" $arch) | quote }}
path = "diffsitter"
executable = true
refreshPeriod = "720h"

[".local/bin/git-diffsitter"]
type = "archive-file"
url = {{ gitHubLatestReleaseAssetURL "afnanenayet/diffsitter" (printf "diffsitter-%s-unknown-linux-gnu.tar.gz" $arch) | quote }}
path = "git-diffsitter"
executable = true
refreshPeriod = "720h"

[".local/bin/tmux-sessionizer"]
type = "file"
url = "https://raw.githubusercontent.com/ThePrimeagen/tmux-sessionizer/refs/heads/master/tmux-sessionizer"
refreshPeriod = "168h"
executable = true

{{- /* kanata keyboard remapper. This repo is applied from WSL but manages the  */}}
{{- /* Windows-side kanata, so stage the whole Windows release here; the         */}}
{{- /* run_onchange kanata script copies the GUI/tray build onto the Windows     */}}
{{- /* host. Skip on headless boxes with no keyboard to remap.                   */}}
{{- if not .headless }}
[".local/share/kanata"]
type = "archive"
url = {{ gitHubLatestReleaseAssetURL "jtroo/kanata" "windows-binaries-x64.zip" | quote }}
refreshPeriod = "720h"
{{- end }}

{{- if .personal }}
[".local/share/quarto"]
type = "archive"
url = {{ gitHubLatestReleaseAssetURL "quarto-dev/quarto-cli" (printf "quarto-*-linux-%s.tar.gz" .chezmoi.arch) | quote }}
executable = true
stripComponents = 1
refreshPeriod = "720h"
{{- end }}

{{- end }}

# vim: ft=toml
